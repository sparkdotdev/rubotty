<!DOCTYPE html>
<html lang="en" data-rb-base="<%= h(request.script_name) %>"
      data-rb-client-section="<%= @client_section ? "true" : "false" %>">
<head>
  <meta charset="utf-8">
  <%# First thing in the document, above every stylesheet: see App#dashboard_head_script. %>
  <script><%= dashboard_head_script %></script>
  <link rel="stylesheet" data-rb-swatch="clay" href="<%= request.script_name %>/swatch-clay.css">
  <script src="<%= request.script_name %>/dashboard-runtime.js" defer></script>
  <script src="<%= request.script_name %>/dashboard-boot.js" defer></script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>rubotty <%= Rubotty::VERSION %> web admin</title>
  <%# The fallback styles cover pages before the dashboard starts or when assets are unavailable. %>
  <style><%= floor_stylesheet %></style>
  <%# Unlayered, and the floor above sits in a cascade layer, so a property
      this stylesheet declares wins over the floor's whatever the two
      selectors weigh. %>
  <link rel="stylesheet" href="<%= request.script_name %>/dashboard.css">
  <%# Hydrates server-rendered charts using the same standard renderer as client navigation. %>
  <script defer src="<%= request.script_name %>/chart-engine.js"></script>
</head>
<body>
  <div id="rb-shell" hidden></div>
  <%# Startup moves the server-rendered content and footer into the shell. %>
  <div id="rb-staging" hidden>
    <div id="rb-content"<%= @wide_page ? ' class="wide"' : "" %>>
      <% if (notice = take_flash(:notice)) %><div class="flash notice"><%= h(notice) %></div><% end %>
      <% if (error = take_flash(:error)) %><div class="flash error"><%= h(error) %></div><% end %>
      <%# A client-rendered section's draw() replaces only this element, so a flash
          above survives a redraw instead of being wiped with the ERB body. %>
      <div id="rb-view"><%= yield %></div>
    </div>
    <footer class="bottom" id="rb-footer">
      Rubotty v<%= h(Rubotty::VERSION) %>. Copyright Spark Software Development, LLC.
      Operation requires adherence to our <a href="https://github.com/sparkdotdev/rubotty/blob/main/LICENSE.MD">License Terms</a>.
    </footer>
  </div>
  <script id="rb-shell-data" type="application/json"><%= initial_shell_json %></script>
  <%# Show the server-rendered page if the dashboard scripts never load. %>
  <script>
    addEventListener("load", function () {
      var staging = document.getElementById("rb-staging");
      var content = document.getElementById("rb-content");
      if (staging && content && content.parentNode === staging) staging.removeAttribute("hidden");
    });
  </script>
</body>
</html>
