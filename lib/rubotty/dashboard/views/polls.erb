<h1><%= h(@community.name) %>: polls</h1>
<%= no_rooms_notice(@community) %>

<div class="card">
  <p class="muted">
    Every open <strong>poll</strong> and open <strong>scheduling</strong> session (from /schedule, the same
    underlying poll with a different kind) across this community's rooms, soonest deadline first. Cancelling
    one here closes it immediately and withdraws its pending close and repost jobs, the same as replying
    "cancel" on the card itself. Creating a poll is a chat-only action; this page only lists and cancels.
  </p>
</div>

<div class="card">
  <h2>Open polls</h2>
  <% if @polls.empty? %>
    <p class="muted">No open polls.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Kind</th><th>Question</th><th>Room</th><th>Closes</th><th>Options</th><th>Votes</th>
          <th>Created by</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @polls.each do |poll| %>
          <% room = @rooms_by_id[poll.room_id] %>
          <tr>
            <td>
              <span class="pill <%= poll.schedule? ? "discovered" : "off" %>">
                <%= poll.schedule? ? "Scheduling" : "Poll" %>
              </span>
            </td>
            <td><%= h(poll.question) %></td>
            <td><code><%= h(room && (room.label.to_s.empty? ? room.room_key : room.label)) %></code></td>
            <td><%= h(poll.closes_at.strftime("%Y-%m-%d %H:%M UTC")) %></td>
            <td><%= @option_counts[poll.id] %></td>
            <td><%= @vote_counts[poll.id] %></td>
            <td><%= h(poll.created_by) %></td>
            <td>
              <form class="inline" method="post"
                    action="<%= request.script_name %>/communities/<%= h(@community.slug) %>/polls/<%= poll.id %>/cancel">
                <%= act_button("Cancel", :configure_poll, community: @community, style: "danger") %>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<%= erb :_leftover_config, layout: false %>
