import { escapeHtml } from "../runtime/primitives.civet"
import { signedIn, visibleCrumbs, scopeItems } from "../runtime/shell.civet"
import { effective, opposite, store } from "../runtime/mode-storage.civet"

// Series A's chrome: a 264px sticky sidebar beside a topbar (drawn against
// DashboardMockups/02-sidebar-saas), a drawer over a backdrop below 900px.
//
// Every piece comes from the shell document /internal/shell answers with
// (Rubotty::Dashboard::Nav); this file decides
// only the SHAPE. Separate from ./index.civet on purpose: that one draws
// no markup of its own, composing CONTENT from the shared primitives
// instead.

// The one glyph set, keyed by the nav entry's own key with a fallback, so a
// section added to the catalogue tomorrow draws with the neutral mark instead
// of nothing at all. Presentation, so it belongs to the theme rather than to
// the nav document.
ICONS := {
  overview: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"
  communities: "M3 7l9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4"
  analytics: "M4 20V10M10 20V4M16 20v-8M22 20H2"
  alerts: "M6 9a6 6 0 0112 0c0 5 2 6 2 6H4s2-1 2-6M10 21h4"
  files: "M6 3h8l4 4v14H6zM14 3v4h4"
  audit: "M4 6h16M4 12h16M4 18h10"
  rooms: "M3 6h11v9H8l-5 4zM10 3h11v9h-3v3"
  platforms: "M9 3v6M15 3v6M6 9h12v4a6 6 0 01-12 0zM12 19v3"
  endpoints: "M5 6a2 2 0 100-.1M19 6a2 2 0 100-.1M12 19a2 2 0 100-.1M6 7l5 10M18 7l-5 10"
  discovered: "M12 12a9 9 0 010-.1M4 12a8 8 0 0116 0M8 12a4 4 0 018 0"
  features: "M4 7h10M18 7h2M4 17h4M12 17h8M15 4v6M8 14v6"
  participation: "M5 4h14v14H5zM9 9h.01M15 9h.01M9 14h.01M15 14h.01"
  redirections: "M4 8h11l-3-3M20 16H9l3 3"
  webhooks: "M8 8a4 4 0 116 3l-2 4M6 14a4 4 0 104 6h6M18 12a4 4 0 11-3 6"
  scripts: "M9 7l-5 5 5 5M15 7l5 5-5 5"
  moderation: "M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"
  operators: "M9 11a4 4 0 100-8 4 4 0 000 8M3 21a6 6 0 0112 0M17 8h4M19 6v4"
  "backfill-proposals": "M4 12a8 8 0 108-8M4 12V7M4 12h5M12 8v5l4 2"
  accounts: "M3 7h18v11H3zM3 11h18M7 15h4"
  integrations: "M10 4h4v4h4v4h-4v4h-4v-4H6V8h4z"
  "api-keys": "M14 8a4 4 0 110 8 4 4 0 010-8M11 12H3M6 12v4"
  "operator-tokens": "M10 5H5v14h5M14 12H8M14 8l4 4-4 4"
  administrators: "M4 18h16M4 18l2-8 4 5 2-9 2 9 4-5 2 8"
  viewers: "M2 12s4-6 10-6 10 6 10 6-4 6-10 6-10-6-10-6M12 14a2 2 0 100-4 2 2 0 000 4"
  onboarding: "M3 13h5l2 3h4l2-3h5M3 13l3-8h12l3 8v6H3z"
  fallback: "M6 12h12"
}

// Two glyphs the chrome itself needs, which no nav entry keys.
CHEVRON := "M6 9l6 6 6-6"
BARS := "M3 6h18M3 12h18M3 18h18"
LOOKING_GLASS := "M11 4a7 7 0 100 14 7 7 0 000-14M21 21l-4.3-4.3"
DEPLOYMENT := "M4 10l8-6 8 6v10H4zM10 20v-6h4v6"
LEAVE := "M14 5H5v14h9M13 12H9M17 8l4 4-4 4"
MOON := "M20 14.5A8.5 8.5 0 1110 3.3a6.7 6.7 0 108.7 8.7c.4 0 .9 0 1.3-.1z"
SUN := "M12 3v2.5M12 18.5V21M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M3 12h2.5M18.5 12H21M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8M12 8.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z"
HELP := "M12 21a9 9 0 100-18 9 9 0 000 18zM9.5 9a2.5 2.5 0 015 .5c0 1.7-2.5 1.8-2.5 3.5M12 17h.01"

esc := escapeHtml

function icon(path: string): string
  `<svg class="rb-shell-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" ` +
    `stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ` +
    `aria-hidden="true"><path d="${esc(path)}"></path></svg>`

// A two letter mark for a name, which is what the mockup puts in the
// workspace and identity avatars.
function initials(text: any): string
  words := String(text ?? "").trim().split(/\s+/).filter (word: string) => word !== ""
  return "rb" if words.length is 0
  return words[0].slice(0, 2).toUpperCase() if words.length is 1

  `${words[0][0]}${words[1][0]}`.toUpperCase()

function dot(status: any): string
  live := status is "active"
  `<span class="rb-shell-dot rb-shell-dot--${live ? "live" : "off"}" aria-hidden="true"></span>`

// Brand.

function drift(warnings: any[]): string
  (warnings ?? []).map((warning: any) => `<span class="rb-shell-drift">${esc(warning)}</span>`).join ""

function brand(nav: any): string
  mark := nav?.brand ?? {}
  build := [mark.version, mark.commit].filter((part: any) => part).join " · "
  `<div class="rb-shell-brand">${icon(ICONS.overview)}<div>` +
    `<div class="rb-shell-brand-name">${esc(mark.product ?? "rubotty")}</div>` +
    `<div class="rb-shell-brand-meta">web admin · ${esc(build)}</div>` +
    `</div>${drift(mark.drift)}</div>`

// Scope switcher. Both scopes' navigation is already in the document, so
// switching is a local swap rather than a page load: an operator comparing a
// community against the deployment around it never leaves the page they are
// reading.

function scopeButton(scope: any): string
  current := scope.current ? " rb-shell-scope--current" : ""
  `<button type="button" class="rb-shell-scope${current}" data-shell-scope="${esc(scope.key)}">` +
    `${esc(scope.key is "community" ? "Community" : "Deployment")}</button>`

// The community pill on a page with no community scope in hand: there is no
// per-community nav in the document to swap to locally, so this is a real
// link back to the communities list rather than the button above's
// client-side toggle. Kept in the same slot so the pair never disappears and
// the rail below it never jumps.
function scopeLink(path: string): string
  `<a class="rb-shell-scope" href="${esc(path)}">Community</a>`

function scopes(nav: any): string
  list := nav?.scopes ?? []
  return "" if list.length is 0

  deployment := list.find((scope: any) => scope.key is "deployment") ?? list[0]
  community := list.find((scope: any) => scope.key is "community")
  pair := (community ? scopeButton(community) : scopeLink(deployment.path)) + scopeButton(deployment)
  `<div class="rb-shell-scopes">${pair}</div>`

// Workspace: which community (or which deployment) the sidebar is about, and
// the picker that moves between them.

function switcherItem(row: any): string
  `<a class="rb-shell-menu-item" href="${esc(row.path)}">${dot(row.status)}${esc(row.label)}` +
    `<span class="rb-shell-workspace-meta">${esc(row.slug)}</span></a>`

function switcherMenu(nav: any, label: string): string
  rows := (nav?.communities ?? []).map(switcherItem).join ""
  body := rows or `<span class="rb-shell-menu-item">No community is open to you yet.</span>`
  `<div class="rb-shell-menu" data-shell-switcher><span class="rb-shell-menu-label">${esc(label)}` +
    `</span>${body}</div>`

function workspace(nav: any, scope: any): string
  community := scope.key is "community"
  name := community ? scope.label : (nav?.brand?.product ?? "Deployment")
  count := (nav?.communities ?? []).length
  meta := community ? `${scope.slug} · ${scope.status}` : `${count} ${count is 1 ? "community" : "communities"}`
  hidden := scope.current ? "" : " hidden"
  `<div class="rb-shell-workspace" data-shell-workspace="${esc(scope.key)}"${hidden}>` +
    `<button type="button" class="rb-shell-workspace-button" data-shell-switch>` +
    `<span class="rb-shell-avatar">${community ? esc(initials(name)) : icon(DEPLOYMENT)}</span>` +
    `<span class="rb-shell-workspace-name">${esc(name)}</span>` +
    `<span class="rb-shell-workspace-meta">${community ? dot(scope.status) : ""}${esc(meta)}</span>` +
    `${icon(CHEVRON)}</button>` +
    switcherMenu(nav, community ? "Switch community" : "Jump to community") +
    "</div>"

// Navigation. One <nav> per scope, the one that is not current hidden rather
// than absent, so the switcher above has something to swap to without a
// round trip.

function badge(item: any): string
  return "" unless item.badge

  `<span class="rb-shell-badge">${esc(item.badge)}</span>`

function link(item: any): string
  current := item.current ? " rb-shell-link--current" : ""
  here := item.current ? ' aria-current="page"' : ""
  `<a class="rb-shell-link${current}" href="${esc(item.path)}"${here}>` +
    `${icon(ICONS[item.key] ?? ICONS.fallback)}<span>${esc(item.label)}</span>${badge(item)}</a>`

function group(entry: any): string
  list := `<div class="rb-shell-list">${(entry.items ?? []).map(link).join("")}</div>`
  return `<div class="rb-shell-group">${list}</div>` unless entry.label

  // Drawn open, and the head says which it is: with no aria-expanded, a screen
  // reader has nothing to announce here but "button".
  `<div class="rb-shell-group"><button type="button" class="rb-shell-group-head" data-shell-group ` +
    `aria-expanded="true"><span class="rb-shell-group-label">${esc(entry.label)}</span>` +
    `${icon(CHEVRON)}</button>${list}</div>`

function navigation(scope: any): string
  hidden := scope.current ? "" : " hidden"
  `<nav class="rb-shell-nav" data-shell-nav="${esc(scope.key)}"${hidden}>` +
    `${(scope.groups ?? []).map(group).join("")}</nav>`

// Identity, and the way out.

function identity(nav: any): string
  who := nav?.operator ?? {}
  signed := signedIn nav
  label := signed ? (who.label ?? "Operator") : "Not signed in"
  role := who.read_only ? "Read only" : label
  logout := if signed
    `<form method="post" action="${esc(nav?.logout_path)}">` +
      `<button type="submit" class="rb-shell-icon-button" title="Log out" aria-label="Log out">` +
      `${icon(LEAVE)}</button></form>`
  else
    ""
  `<div class="rb-shell-identity"><span class="rb-shell-avatar">${esc(initials(label))}</span>` +
    `<span class="rb-shell-identity-name">${esc(label)}</span>` +
    `<span class="rb-shell-identity-role">${esc(role)}</span>${logout}</div>`

// Topbar: where the reader is, and the controls that belong to the whole
// panel rather than to a page.

function crumbTrail(nav: any): string
  // Three: the root, the community and the page inside it. The mockup shows
  // the last two and drops the root below 900px, which the stylesheet does.
  trail := visibleCrumbs nav, 3
  trail.map((crumb: any, index: number) =>
    separator := index is 0 ? "" : '<span class="rb-shell-crumb-sep">/</span>'
    body := crumb.path
      ? `<a class="rb-shell-crumb" href="${esc(crumb.path)}">${esc(crumb.label)}</a>`
      : `<span class="rb-shell-crumb rb-shell-crumb--current">${esc(crumb.label)}</span>`
    separator + body
  ).join ""

// Drawn even when there is no trail, so update() below has somewhere stable
// to put the next one.
function crumbs(nav: any): string
  `<div class="rb-shell-crumbs">${crumbTrail(nav)}</div>`

function search(nav: any): string
  find := nav?.search ?? {}
  `<div class="rb-shell-search">${icon(LOOKING_GLASS)}` +
    `<input class="rb-shell-search-field" type="search" data-shell-search autocomplete="off" ` +
    `aria-label="Search" placeholder="${esc(find.placeholder ?? "Search")}" ` +
    `data-shell-search-path="${esc(find.path ?? "")}">` +
    `<div class="rb-shell-menu" data-shell-found></div></div>`

// Light/dark toggle: the panel's only route into dark mode from inside
// itself, since the OS preference is otherwise the sole switch. Reads and
// writes mode-storage.civet directly rather than through nav, which carries
// no theme state of its own. Safe now that the dashboard's fallback
// stylesheet reads data-theme as well as prefers-color-scheme, so an
// unported screen tracks the same choice as the chrome around it.
function modeIcon(): string
  icon (effective() is "dark" ? SUN : MOON)

function modeToggle(): string
  `<button type="button" class="rb-shell-icon-button" data-shell-mode-toggle ` +
    `aria-label="Switch to ${esc(opposite())} mode">${modeIcon()}</button>`

// The scripting reference and the README, the one destination every scope
// shares regardless of what community or deployment page a reader is on.
// Absent from the signed-out shell document, since it sits behind a session.
function helpButton(nav: any): string
  path := nav?.help_path
  return "" unless path

  `<a class="rb-shell-icon-button" href="${esc(path)}" title="Help" aria-label="Help">${icon(HELP)}</a>`

// A quiet visual anchor for who is signed in, distinct from the full
// identity block at the foot of the sidebar: that one carries the way out
// (logout), this one only says who is looking, which matters most below the
// drawer breakpoint where the sidebar itself is off screen until opened.
function avatarChip(nav: any): string
  who := nav?.operator ?? {}
  signed := signedIn nav
  label := signed ? (who.label ?? "Operator") : "Not signed in"
  announcement := signed ? `Signed in as ${label}` : label
  `<span class="rb-shell-icon-button" title="${esc(label)}" aria-label="${esc(announcement)}">` +
    `${esc(initials(label))}</span>`

function topbar(nav: any): string
  `<header class="rb-shell-topbar"><div class="rb-shell-topbar-start">` +
    `<button type="button" class="rb-shell-toggle" data-shell-toggle aria-label="Show navigation">` +
    `${icon(BARS)}</button>${crumbs(nav)}</div>` +
    `<div class="rb-shell-topbar-end">${search(nav)}${modeToggle()}${helpButton(nav)}${avatarChip(nav)}</div></header>`

// The whole chrome.

function chrome(nav: any): string
  list := nav?.scopes ?? []
  `<div class="rb-shell">` +
    `<div class="rb-shell-backdrop" data-shell-backdrop></div>` +
    `<aside class="rb-shell-side" data-shell-side>${brand(nav)}${scopes(nav)}` +
    `${list.map((scope: any) => workspace(nav, scope)).join("")}` +
    `${list.map(navigation).join("")}${identity(nav)}</aside>` +
    `<div class="rb-shell-main">${topbar(nav)}<main class="rb-shell-content"></main>` +
    `<div class="rb-shell-footer"></div></div>` +
    "</div>"

// Behaviour. Every handler below is delegated from the chrome root, so
// nothing is bound per element and a redraw needs no rebinding.

OPEN := "rb-shell-menu--open"
COLLAPSED := "rb-shell-group--collapsed"

function closeMenus(root: any): void
  for menu of Array.from(root.querySelectorAll `.${OPEN}`)
    menu.classList.remove OPEN

function setScope(root: any, key: string): void
  for button of Array.from(root.querySelectorAll "[data-shell-scope]")
    button.classList.toggle "rb-shell-scope--current", button.dataset.shellScope is key
  for region of Array.from(root.querySelectorAll "[data-shell-nav], [data-shell-workspace]")
    shown := (region.dataset.shellNav ?? region.dataset.shellWorkspace) is key
    if shown then region.removeAttribute "hidden" else region.setAttribute "hidden", ""
  closeMenus root

// The search field, against the same /search.json the panel already serves.
// Debounced because a keystroke is not a question yet, and abandoned rather
// than queued when a newer one arrives.
timer .= null
found .= 0

function renderResults(box: any, payload: any): void
  rows := [
    ...(payload?.destinations ?? []).map (offer: any) =>
      { path: offer.path, label: offer.label, meta: offer.community_name ?? "" }
    ...(payload?.entities ?? []).map (hit: any) =>
      { path: hit.path, label: hit.title, meta: hit.detail ?? hit.community_name ?? "" }
  ].slice 0, 8
  if rows.length is 0
    box.innerHTML = '<span class="rb-shell-menu-item">Nothing matches that.</span>'
  else
    box.innerHTML = rows.map((row: any) =>
      `<a class="rb-shell-menu-item" href="${esc(row.path)}">${esc(row.label)}` +
        `<span class="rb-shell-workspace-meta">${esc(row.meta)}</span></a>`
    ).join ""
  box.classList.add OPEN

async function runSearch(field: any, box: any, ticket: number): Promise<void>
  query := field.value.trim()
  if query.length < 2
    box.classList.remove OPEN
    return

  try
    url := `${field.dataset.shellSearchPath}?q=${encodeURIComponent(query)}`
    response := await fetch url, { credentials: "same-origin" }
    return unless response.ok
    payload := await response.json()
    return unless ticket is found

    renderResults box, payload
  catch
    box.classList.remove OPEN

function onInput(root: any, field: any): void
  box := root.querySelector "[data-shell-found]"
  return unless box and field.dataset.shellSearchPath

  clearTimeout timer if timer
  found += 1
  ticket := found
  timer = setTimeout((() => runSearch field, box, ticket), 200)

function onClick(root: any, event: any): void
  target := event.target
  return unless target?.closest

  if (toggle := target.closest "[data-shell-mode-toggle]")
    store opposite()
    toggle.innerHTML = modeIcon()
    toggle.setAttribute "aria-label", `Switch to ${opposite()} mode`
    return

  if (button := target.closest "[data-shell-scope]")
    setScope root, button.dataset.shellScope
    return

  if (head := target.closest "[data-shell-group]")
    collapsed := head.parentElement.classList.toggle COLLAPSED
    head.setAttribute "aria-expanded", collapsed ? "false" : "true"
    return

  if (switcher := target.closest "[data-shell-switch]")
    menu := switcher.parentElement.querySelector "[data-shell-switcher]"
    wasOpen := menu.classList.contains OPEN
    closeMenus root
    menu.classList.add OPEN unless wasOpen
    return

  if target.closest "[data-shell-toggle]"
    root.querySelector(".rb-shell").classList.toggle "rb-shell--open"
    return

  if target.closest "[data-shell-backdrop]"
    root.querySelector(".rb-shell").classList.remove "rb-shell--open"
    return

  // A click anywhere else, including on a link out of one of them, puts every
  // open menu away.
  closeMenus root unless target.closest "[data-shell-switcher]"

// Fresh chrome after a navigation, patched in place rather than redrawn: a
// redraw would put every collapsed group back open and undo a scope the
// reader had switched to. Returns false when the shell document describes a
// different set of scopes or destinations. A different community keeps the
// same scope keys but every community link changes, so it needs fresh chrome.
function update(context: any): boolean
  root := context.root
  nav := context.nav
  wanted := (nav?.scopes ?? []).map((scope: any) => scope.key).join ","
  drawn := Array.from(root.querySelectorAll "[data-shell-nav]")
    .map((region: any) => region.dataset.shellNav).join ","
  return false unless wanted is drawn and wanted !== ""

  wantedPaths := (nav?.scopes ?? []).flatMap((scope: any) => scopeItems scope)
    .map((item: any) => item.path).join ","
  drawnPaths := Array.from(root.querySelectorAll ".rb-shell-link")
    .map((anchor: any) => anchor.getAttribute "href").join ","
  return false unless wantedPaths is drawnPaths

  crumbs := root.querySelector ".rb-shell-crumbs"
  crumbs.innerHTML = crumbTrail nav if crumbs

  field := root.querySelector "[data-shell-search]"
  field.setAttribute "placeholder", nav?.search?.placeholder ?? "Search" if field

  wantedItems := new Map
  for scope of nav?.scopes ?? []
    for item of scopeItems scope
      wantedItems.set item.path, item

  for anchor of Array.from(root.querySelectorAll ".rb-shell-link")
    item := wantedItems.get anchor.getAttribute("href")
    continue unless item

    anchor.classList.toggle "rb-shell-link--current", !!item.current
    if item.current
      anchor.setAttribute "aria-current", "page"
    else
      anchor.removeAttribute "aria-current"
    updateBadge anchor, item

  true

function updateBadge(anchor: any, item: any): void
  drawn := anchor.querySelector ".rb-shell-badge"
  unless item.badge
    drawn?.remove?()
    return

  return drawn.textContent = String(item.badge) if drawn

  anchor.insertAdjacentHTML "beforeend", badge(item)

// Bound on the document rather than on the chrome, so a click that lands
// outside it (the page margin, an unported screen's own form) still puts an
// open menu away. Once only: the mount records it on its own element, which
// survives a redraw, and every handler above is delegated so a redraw needs no
// rebinding.
function bind(context: any): void
  root := context.root
  return if root.dataset?.shellBound

  root.dataset.shellBound = "series-a"
  document.addEventListener "click", (event: any) => onClick root, event
  document.addEventListener "input", (event: any) =>
    onInput root, event.target if event.target?.hasAttribute?("data-shell-search")

shell := { chrome, slots: { content: ".rb-shell-content", footer: ".rb-shell-footer" }, bind, update }

export { shell, chrome, ICONS }
