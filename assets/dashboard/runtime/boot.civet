// Mount the dashboard with the server-rendered navigation and content.
function shellData(): any
  node := document.getElementById "rb-shell-data"
  return null unless node

  JSON.parse node.textContent ?? ""

// The content remains staged when startup cannot mount the dashboard.
function staged(staging: any): boolean
  return false unless staging

  document.getElementById("rb-content")?.parentNode is staging

// Keep the server-rendered page visible if startup could not move it.
function settle(staging: any): void
  return unless staging

  if staged staging
    staging.removeAttribute "hidden"
  else
    staging.setAttribute "hidden", ""

// A save's notice sits above the page content, which a phone layout can push below the fold.
function revealFlash(): void
  flash := document.querySelector "#rb-content > .flash"
  return unless flash and typeof flash.scrollIntoView is "function"

  box := flash.getBoundingClientRect()
  return if box.top >= 0 and box.bottom <= window.innerHeight

  flash.scrollIntoView block: "center"

async function boot(): Promise<void>
  root := document.documentElement
  staging := document.getElementById "rb-staging"
  try
    await rubottyDashboard.start(
      base: root.dataset.rbBase ?? ""
      root: document.getElementById "rb-view"
      shell: document.getElementById "rb-shell"
      content: document.getElementById "rb-content"
      footer: document.getElementById "rb-footer"
      nav: shellData()
      sections: root.dataset.rbClientSection is "true"
    )
  finally
    settle staging
    revealFlash()

boot().catch (error: any) => console?.error? "rubotty dashboard could not start", error
