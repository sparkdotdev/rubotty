import { MODES, MODE_KEY, apply, effective, opposite, restore, store, stored } from "./mode-storage.civet"
import {
  escapeHtml, attributes, Format, page, section, notice, table, form, field, button, editMappingList,
  state as statusPill, tag, tags, keyValues, statRow, code, tabLinks, prose, toggleSummary
} from "./primitives.civet"
import {
  CHART_SHAPES, chart, chartRows, chartTable
} from "./chart.civet"
import {
  SHELL_SOURCE, SHELL_ROLES, slotIn, adopt, currentScope, otherScopes,
  scopeItems, visibleCrumbs, signedIn
} from "./shell.civet"
import { SCREENS } from "./screens.civet"
import { shell } from "./chrome.civet"
import { applyScriptTriggers } from "./script-triggers.civet"
import { drawScriptRules, editScriptRules } from "./script-rules.civet"
import { load as loadYaml } from "js-yaml"

// Where a client-rendered page reads its data. Deliberately not the public /api: that
// one authenticates a bearer token carrying a developer or administrator
// scope, this one rides the operator's dashboard session and their per
// community grants, and a single surface answering to both auth models is how
// one of those scopes gets widened by accident.
INTERNAL_PREFIX := "/internal"

// The sections that have been ported, page path to data path. First match
// wins, so the longer template comes first, and a path absent from here is
// not a client-rendered section: the router hands it back to the browser as an
// ordinary link, which lets the panel stay whole while the migration works
// through the section groups one at a time.
ROUTES := [
  { section: "feature_config", template: "/communities/:slug/features/:feature/config", source: "/communities/:slug/features/:feature/config" }
  { section: "room_channel", template: "/communities/:slug/rooms/channels/:id", source: "/communities/:slug/rooms/channels/:id" }
  { section: "automatic_mapping", template: "/communities/:slug/rooms/automatic-mapping", source: "/communities/:slug/rooms/automatic-mapping" }
  { section: "room_detail", template: "/communities/:slug/rooms/:room_key", source: "/communities/:slug/rooms/:room_key" }
  { section: "endpoint_edit", template: "/communities/:slug/endpoints/new", source: "/communities/:slug/endpoints/new" }
  { section: "endpoint_edit", template: "/communities/:slug/endpoints/:id", source: "/communities/:slug/endpoints/:id" }
  { section: "script_edit", template: "/communities/:slug/scripts/new", source: "/communities/:slug/scripts/new" }
  { section: "script_edit", template: "/communities/:slug/scripts/:id", source: "/communities/:slug/scripts/:id" }
  { section: "audit", template: "/communities/:slug/audit", source: "/communities/:slug/audit" }
  { section: "features", template: "/communities/:slug/features", source: "/communities/:slug/features" }
  { section: "rooms", template: "/communities/:slug/rooms", source: "/communities/:slug/rooms" }
  { section: "endpoints", template: "/communities/:slug/endpoints", source: "/communities/:slug/endpoints" }
  { section: "redirections", template: "/communities/:slug/redirections", source: "/communities/:slug/redirections" }
  { section: "webhooks", template: "/communities/:slug/webhooks", source: "/communities/:slug/webhooks" }
  { section: "people", template: "/communities/:slug/people", source: "/communities/:slug/people" }
  { section: "moderation", template: "/communities/:slug/moderation", source: "/communities/:slug/moderation" }
  { section: "events", template: "/communities/:slug/events", source: "/communities/:slug/events" }
  { section: "word_filter", template: "/communities/:slug/word-filter", source: "/communities/:slug/word-filter" }
  { section: "faq", template: "/communities/:slug/faq", source: "/communities/:slug/faq" }
  { section: "analytics", template: "/communities/:slug/analytics", source: "/communities/:slug/analytics" }
  { section: "operators", template: "/communities/:slug/operators", source: "/communities/:slug/operators" }
  { section: "platforms", template: "/communities/:slug/platforms", source: "/communities/:slug/platforms" }
  { section: "polls", template: "/communities/:slug/polls", source: "/communities/:slug/polls" }
  { section: "guests", template: "/communities/:slug/guests", source: "/communities/:slug/guests" }
  { section: "scripts", template: "/communities/:slug/scripts", source: "/communities/:slug/scripts" }
  { section: "participation", template: "/communities/:slug/participation", source: "/communities/:slug/participation" }
  { section: "alerts", template: "/communities/:slug/alerts", source: "/communities/:slug/alerts" }
  { section: "files", template: "/communities/:slug/files", source: "/communities/:slug/files" }
  { section: "overview", template: "/communities/:slug", source: "/communities/:slug" }
  { section: "analytics_overview", template: "/analytics", source: "/analytics" }
  { section: "accounts", template: "/accounts", source: "/accounts" }
  { section: "api_keys", template: "/api-keys", source: "/api-keys" }
  { section: "viewers", template: "/viewers", source: "/viewers" }
  { section: "onboarding", template: "/onboarding", source: "/onboarding" }
  { section: "operator_tokens", template: "/operator-tokens", source: "/operator-tokens" }
  { section: "administrators", template: "/administrators", source: "/administrators" }
  { section: "integrations", template: "/integrations", source: "/integrations" }
  { section: "backfill_proposals", template: "/backfill-proposals", source: "/backfill-proposals" }
  { section: "datastore", template: "/settings/datastore", source: "/settings/datastore" }
  { section: "documentation", template: "/documentation", source: "/documentation" }
  { section: "licence", template: "/licence", source: "/licence" }
  { section: "audit", template: "/audit", source: "/audit" }
  { section: "communities", template: "/", source: "/communities" }
]

state := {
  started: false
  base: ""
  root: null
  parse: loadYaml
  // The chrome mount, the page node moved into it, and its staging home, so
  // stop() can put the document back the way it found it.
  shellRoot: null
  content: null
  footer: null
  contentHome: null
  footerHome: null
  shellMounted: false
  // The navigation document backing the current shell.
  nav: null
  // The view currently drawn, or null between a teardown and the next draw.
  // Only a view rendered by the dashboard needs to be cleared.
  view: null
  // The last document read per section, which is what the next draw of that
  // section is compared against to work out what changed.
  lastData: {}
  onClick: null
  onChange: null
  onPopState: null
  onConfirm: null
}

// Split a path into its segments, so "/", "" and "/communities/" all compare
// the way a reader expects.
function segments(path: string): string[]
  path.split("/").filter (part) => part !== ""

// The params a template takes from a path, or null when it does not match.
function matchTemplate(template: string, path: string): any
  wanted := segments template
  actual := segments path
  return null unless wanted.length is actual.length

  params := {}
  for index of [0...wanted.length]
    part := wanted[index]
    if part.startsWith ":"
      params[part.slice(1)] = decodeURIComponent actual[index]
    else if part !== actual[index]
      return null

  params

// Put params back into a template, which is how a page path becomes the data
// path it reads from.
function fillTemplate(template: string, params: any): string
  filled := segments(template).map (part) =>
    if part.startsWith ":" then encodeURIComponent(params[part.slice(1)]) else part
  `/${filled.join("/")}`

// Which section a page path belongs to, with its params, or null for a path
// no client renderer handles.
function resolve(path: string): any
  for route of ROUTES
    params := matchTemplate route.template, path
    return { section: route.section, source: route.source, params } if params

  null

function draws(section: string): boolean
  Object.prototype.hasOwnProperty.call SCREENS, section

// The page path, with the mount prefix taken off. The dashboard is served
// standalone in development and under a prefix (/admin-panel) in some
// deployments, and every path the router reasons about is prefix free.
function stripBase(pathname: string): string
  return pathname if state.base is ""
  return pathname unless pathname is state.base or pathname.startsWith `${state.base}/`

  pathname.slice(state.base.length) or "/"

function currentPath(): string
  stripBase window.location.pathname

// What changed between the last draw and this one, as a list of top level
// keys, given to draw rather than left to rescan the DOM, since a renderer
// that diffs the page on every navigation ends up doing more work than the
// render it was trying to avoid. Compared through JSON, which is exact for
// the plain maps, lists, strings and numbers a YAML document decodes to,
// and which nothing on this wire is allowed to be anything other than.
function changedKeys(previous: any, next: any): string[]
  keys := Object.keys(next ?? {})
  return keys unless previous

  union := new Set [...Object.keys(previous), ...keys]
  Array.from(union).filter (key) =>
    JSON.stringify(previous[key]) !== JSON.stringify(next[key])

// Read one section's document off the internal surface: credentials are
// sent because the dashboard session cookie is the whole authentication,
// and without them every read here would be a 401. +search+ (the page
// URL's own query string, "" or "?scope=...") rides along unparsed, since a
// scope selector is a page concern rather than a routing one, so the
// internal surface reads the same params[:scope] the ERB route already
// does.
async function fetchSection(match: any, search: string = ""): Promise<any>
  url := `${state.base}${INTERNAL_PREFIX}${fillTemplate(match.source, match.params)}${search}`
  response := await fetch url,
    credentials: "same-origin"
    headers: { Accept: "application/yaml" }
  throw new Error `${url} answered ${response.status}` unless response.ok

  state.parse await response.text()

// The shell document for a page path: the navigation catalogue, the scope
// switcher, the breadcrumb and the brand facts. Read on every navigation
// rather than derived on the client, because which entry is current, which
// community is in hand and what this reader may see are all the server's
// answers, and a client that recomputed them would be a second, drifting copy
// of the permission rules.
async function fetchNav(path: string): Promise<any>
  url := `${state.base}${INTERNAL_PREFIX}${SHELL_SOURCE}?path=${encodeURIComponent(path)}`
  response := await fetch url,
    credentials: "same-origin"
    headers: { Accept: "application/yaml" }
  throw new Error `${url} answered ${response.status}` unless response.ok

  state.parse await response.text()

// Reattach the same content and footer after drawing fresh navigation.
function drawShell(nav: any): void
  state.shellRoot.innerHTML = shell.chrome nav
  adopt state.shellRoot, shell.slots.content, state.content
  adopt state.shellRoot, shell.slots.footer, state.footer
  shell.bind({ root: state.shellRoot, nav, view, navigate, base: state.base })

// Take the chrome over once at start. The server document remains staged until
// the dashboard has drawn its shell and adopted it.
async function mountShell(): Promise<boolean>
  return false unless state.shellRoot

  try
    state.nav = await fetchNav currentPath() unless state.nav
    state.contentHome = state.content?.parentNode ?? null
    state.footerHome = state.footer?.parentNode ?? null
    drawShell state.nav
    state.shellRoot.removeAttribute "hidden"
    state.shellMounted = true
    true
  catch error
    unmountShell()
    console?.warn?(`The dashboard could not draw its shell: ${error?.message ?? error}`)
    false

// Return the page to its hidden staging node.
function unmountShell(): void
  state.contentHome?.appendChild? state.content if state.content
  state.footerHome?.appendChild? state.footer if state.footer
  state.shellRoot?.setAttribute? "hidden", ""
  state.shellRoot.innerHTML = "" if state.shellRoot
  state.shellMounted = false

// Fresh chrome for the page just navigated to.
async function refreshShell(path: string): Promise<void>
  return unless state.shellMounted

  try
    state.nav = await fetchNav path
  catch
    // Chrome describing the page before this one is a worse answer than fresh
    // chrome and a better one than no chrome, so a failed read leaves it.
    return

  // Redraw if the existing shell cannot show the new navigation in place.
  handled := shell.update(
    { root: state.shellRoot, nav: state.nav, view: state.view, navigate, base: state.base }
  )
  drawShell state.nav unless handled is true

// Undo whatever the last draw did. The view is cleared before the hook runs,
// so a teardown that throws cannot be run twice against the same view.
function teardown(): void
  return unless state.view

  state.view = null
  state.root.innerHTML = "" if state.root

// Go to a page path: tear the current view down, read the next one, then
// draw it, pushing the history entry only after the read succeeds so a
// failed navigation doesn't leave the address bar describing a page that
// isn't on screen. A read that fails falls back to an ordinary page load
// instead of being reported here, since the server already answers that URL
// correctly (including bouncing an expired session to login) and a
// shell that swallowed the failure would strand
// somebody on a broken page; only the read is guarded this way, since a
// throwing draw would otherwise reload, start, throw and loop.
async function navigate(path: string, options: any = {}): Promise<void>
  search := options.search ?? ""
  match := resolve path
  // A path outside the table, or a section the dashboard does not draw: hand it
  // back to the browser and let the server render it, rather than tearing the
  // page down for a draw that would then have nothing to put in its place.
  unless match and draws match.section
    window.location.href = state.base + path + search
    return

  teardown()
  data .= null
  try
    data = await fetchSection match, search
  catch
    window.location.href = state.base + path + search
    return

  drawing := {
    section: match.section
    path
    params: match.params
    data
    changed: changedKeys state.lastData[match.section], data
  }
  state.lastData[match.section] = data
  state.view = drawing
  window.history.pushState { path }, "", state.base + path + search unless options.push is false
  state.root.innerHTML = SCREENS[drawing.section](drawing.data, state.base) if state.root
  // Editor rules depend on the newly drawn fields being in the document.
  drawScriptRules state.root, data
  applyScriptTriggers state.root, data
  await refreshShell path

function onClick(event: any): void
  return if event.defaultPrevented or event.button !== 0
  return if event.metaKey or event.ctrlKey or event.shiftKey or event.altKey

  if editMappingList event.target
    event.preventDefault()
    return

  control := event.target?.closest?("button[name^='rule-']")
  if control
    event.preventDefault()
    editScriptRules state.root, state.lastData?.script_edit, control
    return

  link := event.target?.closest?("a[href]")
  return unless link
  return if link.target or link.hasAttribute("download") or link.getAttribute("rel") is "external"

  url := new URL link.href, window.location.href
  return unless url.origin is window.location.origin

  // Path drives which section draws; the query string (a scope selector, so
  // far) rides along to fetchSection unparsed, the same way a followed link's
  // search reaches the internal surface a native browser navigation would
  // have sent it to.
  path := stripBase url.pathname
  match := resolve path
  return unless match and draws match.section

  event.preventDefault()
  navigate path, { search: url.search }

function onPopState(): void
  navigate currentPath(), { push: false, search: window.location.search }

// Filtering a Table's own rows on keystroke, no request: every row is
// already on the page, the same reasoning a shell's own list pane filters by.
function onTableFilterInput(field: any): void
  toolbar := field.closest ".rb-table-toolbar"
  scroll := toolbar?.nextElementSibling
  return unless scroll?.classList?.contains "rb-table-scroll"

  query := field.value.trim().toLowerCase()
  rows := Array.from(scroll.querySelectorAll "tbody tr")
  visible .= 0
  for row of rows
    text := (row.textContent ?? "").toLowerCase()
    hidden := query.length > 0 and not text.includes(query)
    row.hidden = hidden
    visible += 1 unless hidden

  countEl := toolbar.querySelector ".rb-table-count"
  return unless countEl
  total := rows.length
  countEl.textContent = query.length > 0 ?
    `${visible} of ${total} item${total is 1 ? "" : "s"} shown` :
    `${total} item${total is 1 ? "" : "s"}`

function onInput(event: any): void
  target := event.target
  return unless target?.hasAttribute?("data-table-filter")

  onTableFilterInput target

function onConfirm(event: any): void
  control := event.target?.closest? "[data-confirm]"
  return unless control

  event.preventDefault() unless window.confirm control.getAttribute "data-confirm"

// Changing a condition, or ticking a second one, redraws which boxes the
// editor shows. Delegated like the table filter above, so a client redraw
// never leaves a listener bound to an element that is no longer there.
function onChange(event: any): void
  return unless event.target?.closest?(".rb-form")

  data := state.lastData?.script_edit
  return if editScriptRules state.root, data, event.target

  applyScriptTriggers state.root, data

// Mount the dashboard chrome on every page. Server-only pages keep their
// content and browser navigation.
async function start(options: any = {}): Promise<void>
  throw new Error "The dashboard is already started" if state.started

  state.started = true
  state.base = options.base ?? ""
  state.root = options.root ?? document.body
  state.shellRoot = options.shell ?? null
  state.content = options.content ?? null
  state.footer = options.footer ?? null
  state.parse = options.parse ?? loadYaml
  state.nav = options.nav ?? null
  state.lastData = {}

  restore()

  await mountShell()
  return if options.sections is false

  state.onClick = onClick
  state.onPopState = onPopState
  state.onInput = onInput
  state.onConfirm = onConfirm
  state.onChange = onChange
  document.addEventListener "click", state.onClick
  document.addEventListener "click", state.onConfirm
  window.addEventListener "popstate", state.onPopState
  document.addEventListener "input", state.onInput
  document.addEventListener "change", state.onChange

  // The page the server already rendered is left exactly where it is when this
  // dashboard draws no screen for its section. Handing it to the browser instead
  // would load the address already showing, start again, and do it forever.
  match := resolve currentPath()
  unless match and draws match.section
    // A server-rendered editor still gets its condition behaviour: the module
    // reads the same trigger table off the page when there is no client
    // payload to read it from.
    applyScriptTriggers state.root, null
    return

  await navigate currentPath(), { push: false, search: window.location.search }

// Give navigation back to the browser, tear down whatever is drawn, and return
// the document to its staging node.
function stop(): void
  return unless state.started

  teardown()
  unmountShell()
  document.removeEventListener "click", state.onClick if state.onClick
  document.removeEventListener "click", state.onConfirm if state.onConfirm
  window.removeEventListener "popstate", state.onPopState if state.onPopState
  document.removeEventListener "input", state.onInput if state.onInput
  document.removeEventListener "change", state.onChange if state.onChange
  state.onClick = null
  state.onPopState = null
  state.onInput = null
  state.onConfirm = null
  state.onChange = null
  state.started = false

// The view currently drawn by the dashboard.
function view(): any
  state.view

// The shell document the chrome was last drawn from.
function nav(): any
  state.nav

export {
  MODES, MODE_KEY, INTERNAL_PREFIX, ROUTES, SHELL_SOURCE, SHELL_ROLES,
  apply, effective, opposite, restore, store, stored,
  resolve, start, stop, navigate, view,
  // Navigation and shell helpers.
  shell, nav, slotIn, adopt, currentScope, otherScopes, scopeItems, visibleCrumbs, signedIn,
  // The primitive emitters shared by the dashboard renderers.
  escapeHtml, attributes, Format,
  page, section, notice, table, form, field, button, tag, tags, keyValues, statRow,
  code, tabLinks, prose, statusPill as state, toggleSummary,
  chart, chartRows, chartTable, CHART_SHAPES,
  // Screen renderers and their lifecycle.
  SCREENS
}
